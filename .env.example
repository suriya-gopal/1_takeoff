# Copy to .env and fill in. .env is never committed.
SECRET_KEY=replace-with-a-long-random-string

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Production only
ALLOWED_HOSTS=yourname.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com
HTTPS_ONLY=True
# DATABASE_URL=postgres://user:password@host:5432/dbname
