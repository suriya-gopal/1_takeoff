# Copy to .env and fill in. .env is never committed.
SECRET_KEY=replace-with-a-long-random-string

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Production only
ALLOWED_HOSTS=yourname.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://yourname.pythonanywhere.com
HTTPS_ONLY=True
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Day-by-day drafts (see README_AI.md). All optional.
# AI_LOCAL_ENABLED=True
# AI_LOCAL_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct
# AI_LOCAL_TIMEOUT_SECONDS=120
# AI_DRAFTS_PER_HOUR=10

# Hosted assistant for place suggestions, packing lists and place checks. Leave the key empty to switch it off.
# Any provider with an OpenAI-compatible endpoint works; copy the base URL and model name from its documentation.
AI_API_KEY=
AI_API_MODEL=
AI_API_BASE_URL=
# AI_API_TIMEOUT_SECONDS=30
# AI_API_REQUESTS_PER_HOUR=30
